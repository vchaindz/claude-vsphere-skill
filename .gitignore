# Packaged skill bundle (built artifact, not source)
govc.skill

# Binaries / archives if downloaded into the repo directory.
# NOTE: deliberately no bare "govc" entry — that would also ignore the govc/ skill folder.
/govc.exe
/vcsim
/vcsim.exe
*.tar.gz
*.zip

# govc-safe token map — maps every token back to the REAL name, so it is as
# sensitive as a full inventory dump. Never commit it.
*.db
map.db
creds

# Reports produced by the documented workflows. These are written in tokens, but
# `govc-safe rehydrate` turns them back into real VM names, owners and
# addresses — precisely what must not end up in a public repository.
*.tsv
*.csv
*-report.*
rehydrated-*

# Credentials and local environment — never commit these
.env
.env.*
*.pem
*.key
*.crt
.govc_ca.crt
.govc_known_hosts

# Artifacts produced by the documented workflows
spec.json
*.log
/export-dir/
/debug/

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
